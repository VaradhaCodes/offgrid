<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The logger tab's XML views inherit from this: keep the MaterialComponents parent, and remember every XML button must be
         an explicit androidx.appcompat.widget.AppCompatButton (a bare <Button> becomes a MaterialButton that drops android:background). -->
    <style name="Theme.IDRNav" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">#101010</item>
        <item name="android:textColor">#F2F2F2</item>
        <item name="colorPrimary">#9BE8C4</item>
        <item name="colorAccent">#9BE8C4</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>
    <style name="Theme.IDRNav.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#101010</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_fg</item>
        <item name="postSplashScreenTheme">@style/Theme.IDRNav</item>
    </style>
</resources>
